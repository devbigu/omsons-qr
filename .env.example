OMQR_DB_HOST=your-mysql-host
OMQR_DB_PORT=3306
OMQR_DB_NAME=omqr
OMQR_DB_USER=your-mysql-user
OMQR_DB_PASS=your-mysql-password
OMQR_DB_AUTO_CREATE=false
OMQR_SESSION_DRIVER=database
